# BuildOS web console — local dev environment.
# Copy to `.env.local` (gitignored) and adjust. All client-exposed vars MUST be
# prefixed VITE_ (Vite only inlines those). Never put secrets here — this bundle
# ships to the browser.

# Base URL for the BuildOS API. Leave blank to use the Vite dev proxy (/api ->
# http://localhost:8080, see vite.config.ts). Set to an absolute origin only
# when pointing the dev server at a remote backend.
VITE_API_BASE_URL=
