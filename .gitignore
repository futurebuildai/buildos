# Editor / OS
.DS_Store
*.swp
*~
.idea/
.vscode/

# Docker volumes
pgdata/

# Local DB backups (scripts/backup-db.sh default BACKUP_DIR) — never commit dumps
backups/
*.dump
*.dump.sha256

# Web console (web/) build + dependency artifacts
web/node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
web/.env.local

# Flutter field app (mobile/) build artifacts
mobile/build/
mobile/.dart_tool/

# Claude Code local state
.claude/

# fork-init secret outputs (make fork-init OUT=./forks/...) — the JWT
# signing key, vault master key, and bootstrap token must never be
# committed. public.pem/fork.yaml are committable but live in customer
# fork repos, not here.
forks/
**/private.pem
**/vault_master_key.txt
**/bootstrap_token.txt
# provision.sh writes its Railway ID manifest into the tracked deploy/railway/
# dir — operator-private, never commit it
deploy/railway/provision-output.env
