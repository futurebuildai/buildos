# BuildOS — Environment Variables

# Database (required)
DATABASE_URL=postgres://fb_user:fb_pass@localhost:5433/futurebuild_os?sslmode=disable
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_TIMEOUT=5s

# Server
PORT=8080

# Auth — The Brain OIDC (required in production)
BRAIN_JWKS_URL=http://localhost:8082/jwks
BRAIN_ISSUER_URL=http://localhost:8082

# Auth mode override — leave empty in production.
#   ""        validate JWTs against BRAIN_JWKS_URL (default)
#   "header"  inject claims from X-Dev-Auth: <sub>,<org_id>,<role>[,<plan_tier>]
# For staging/demos using the mock issuer, leave empty and point
# BRAIN_JWKS_URL/BRAIN_ISSUER_URL at cmd/dev-idp instead.
DEV_AUTH_MODE=header
