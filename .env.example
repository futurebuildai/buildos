# BuildOS — Environment Variables

# Database (required)
DATABASE_URL=postgres://fb_user:fb_pass@localhost:5433/futurebuild_os?sslmode=disable
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_TIMEOUT=5s

# Server
PORT=8080

# Auth — native email/password (required in production).
# BuildOS mints and validates its own RS256 JWTs against a per-fork
# RSA keypair. Generate the keypair, the vault master key, and the
# first-owner bootstrap token with `make fork-init OUT=<dir>`.
#
#   JWT_PRIVATE_KEY_PEM  PKCS#8 RSA private key (signs JWTs). Secret.
#   JWT_PUBLIC_KEY_PEM   SPKI RSA public key (verifies JWTs).
#   JWT_KEY_ID           kid embedded in issued tokens (default buildos-1)
#   JWT_ISSUER           iss claim (default "buildos")
#   JWT_AUDIENCE         aud claim (default "buildos")
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=buildos-1

# Credential vault (required in production). AES-256-GCM master key
# (standard-base64 32 bytes) for the encrypted BYOK vault that holds
# the Anthropic API key, Resend API key, and 3rd-party vendor keys.
VAULT_MASTER_KEY=

# First-owner bootstrap token. cmd/server seeds the SHA-256 hash into
# setup_bootstrap_tokens on first boot; the first owner presents this
# cleartext at POST /api/v1/auth/claim. One-shot.
BUILDOS_BOOTSTRAP_TOKEN=

# Auth mode override — leave empty in production.
#   ""        validate JWTs against the native keypair (default)
#   "header"  inject claims from X-Dev-Auth: <sub>,<org_id>,<role>[,<plan_tier>]
# The header bypass is compiled out of prod builds (D8 hardening).
DEV_AUTH_MODE=header
